{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.acceptance.tsbuildinfo"
  },
  "include": [
    "playwright.config.ts",
    "playwright.production.config.ts",
    "tests/production/**/*.ts",
    "tests/browser/**/*.ts"
  ]
}
