# Моки доступны только в npm run dev. По умолчанию запросы идут в backend.
VITE_ENABLE_MOCKS=false

# Начальный сценарий; далее его можно менять в панели «Моковый режим».
# success, slow, network-error, unauthorized, forbidden, conflict,
# validation-error, rate-limit, server-error, bad-gateway, invalid-json, invalid-schema
VITE_MOCK_SCENARIO=success
