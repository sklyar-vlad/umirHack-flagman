# Copy this file to infrastructure/.env on the VPS. Keep it out of Git.
DEPLOY_MODE=vps
FLAGMAN_DOMAIN=warehouse.example.com
ACME_EMAIL=you@example.com

POSTGRES_DB=flagman
POSTGRES_USER=flagman_owner
# Use a long random hexadecimal password (openssl rand -hex 32).
POSTGRES_PASS=
# Compose expands these references; the address is inside Docker, not localhost.
POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASS}@db:5432/${POSTGRES_DB}?sslmode=disable

# At least 32 characters. Generate independent values for these secrets.
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PG_PASSWORD=

# Optional until task seed / task seed-users; passwords must be 12–128 characters.
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_STOREKEEPER_PASSWORD=
DEMO_ORDER_OPERATOR_PASSWORD=
