      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "flagman-prometheus"
          },
          "expr": "histogram_quantile(0.95,sum by(le,route)(rate(flagman_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{worker}} {{route}} {{status}}"
