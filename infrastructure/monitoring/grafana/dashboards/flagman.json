    {
      "id": 17,
      "title": "Losses in selected UTC period by product / unit / reason",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "flagman-warehouse"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "flagman-warehouse"
          },
          "rawSql": "SELECT product_id,unit,reason,sum(quantity) AS quantity,sum(movements) AS movements FROM monitoring_losses WHERE $__timeFilter(time) GROUP BY product_id,unit,reason ORDER BY product_id,unit,reason",
          "format": "table",
          "rawQuery": true
        }
      ],
