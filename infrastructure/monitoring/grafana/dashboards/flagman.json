    {
      "id": 14,
      "title": "Valid and expired stock by product / unit",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "flagman-warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "flagman-warehouse"
          },
          "rawSql": "SELECT product_name,unit,valid_quantity,expired_quantity,target_stock FROM monitoring_stock ORDER BY product_name,product_id",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Problem batches: expired and expiring",
