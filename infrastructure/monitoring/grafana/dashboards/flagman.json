{
  "uid": "flagman",
  "title": "Flagman service and warehouse",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "utc",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "flagman-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "flagman-prometheus"
          },
          "expr": "sum by(route,status)(rate(flagman_http_requests_total[5m]))",
          "legendFormat": "{{worker}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "HTTP errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "flagman-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "flagman-prometheus"
          },
          "expr": "sum by(route)(rate(flagman_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "{{worker}} {{route}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
