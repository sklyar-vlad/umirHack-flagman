DEPLOY_MODE=local
FLAGMAN_DOMAIN=flagman.localhost
ACME_EMAIL=you@example.com

POSTGRES_DB=flagman
POSTGRES_USER=flagman_owner
POSTGRES_PASS=local-database-password
POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASS}@db:5432/${POSTGRES_DB}?sslmode=disable

METRICS_TOKEN=flagman-local-metrics-token-change-on-vps
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-admin-password
GRAFANA_PG_PASSWORD=local-grafana-database-password

DEMO_ADMIN_PASSWORD=local-admin-password
DEMO_MANAGER_PASSWORD=local-manager-password
DEMO_STOREKEEPER_PASSWORD=local-storekeeper-password
DEMO_ORDER_OPERATOR_PASSWORD=local-operator-password

HTTP_PORT=80
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TRAEFIK_PORT=8081
