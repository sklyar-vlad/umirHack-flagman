# Copy to infrastructure/.env. Both modes use this one file.
# local: HTTP, PostgreSQL on 127.0.0.1:5432, local monitoring ports.
# vps: HTTPS via Let's Encrypt, database and Prometheus stay inside Docker.
DEPLOY_MODE=local
FLAGMAN_DOMAIN=flagman.localhost
# On VPS set a real DNS hostname above and your certificate email below.
ACME_EMAIL=you@example.com

POSTGRES_DB=flagman
POSTGRES_USER=flagman_owner
POSTGRES_PASS=local-database-password
# Internal Docker address. For URL-safe passwords use hexadecimal random values.
POSTGRES_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASS}@db:5432/${POSTGRES_DB}?sslmode=disable

# Change these local example values to independent random secrets on VPS.
METRICS_TOKEN=flagman-local-metrics-token-change-on-vps
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-admin-password
GRAFANA_PG_PASSWORD=local-grafana-database-password

# task seed creates these users. Passwords must contain 12-128 characters.
DEMO_ADMIN_PASSWORD=local-admin-password
DEMO_MANAGER_PASSWORD=local-manager-password
DEMO_STOREKEEPER_PASSWORD=local-storekeeper-password
DEMO_ORDER_OPERATOR_PASSWORD=local-operator-password

# Optional local host ports. VPS exposes HTTP/HTTPS and loopback Grafana/Traefik.
# If changing HTTP_PORT, also set FRONTEND_ORIGIN=http://your-local-host:port.
HTTP_PORT=80
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TRAEFIK_PORT=8081
