ENV=development

# SERVER
PORT=8080
READ_TIMEOUT=10
WRITE_TIMEOUT=10
IDLE_TIMEOUT=60

# Allowed Origin for cookie-authenticated writes (scheme, host and optional port).
FRONTEND_ORIGIN=http://flagman.localhost


# DB
POSTGRES_USER=admin
POSTGRES_PASS=admin
POSTGRES_DB=postgres
POSTGRES_URL=postgres://admin:admin@db:5432/postgres

# GOOSE
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://admin:admin@localhost:5432/postgres
GOOSE_MIGRATION_DIR=./backend/database/migrations

# DEMO USERS
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_STOREKEEPER_PASSWORD=
DEMO_ORDER_OPERATOR_PASSWORD=
