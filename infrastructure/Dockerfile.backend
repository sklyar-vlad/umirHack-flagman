FROM golang:1.26-alpine AS build-stage
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o /app/server ./cmd/api && \
    CGO_ENABLED=0 go build -o /app/seed-users ./cmd/seed-users && \
    CGO_ENABLED=0 go build -o /app/migrate ./cmd/migrate

FROM golang:1.26-alpine AS migrate
COPY --from=build-stage /app/migrate /app/migrate
ENTRYPOINT ["/app/migrate"]

FROM golang:1.26-alpine AS seed-users
COPY --from=build-stage /app/seed-users /app/seed-users
ENTRYPOINT ["/app/seed-users", "-env", "/dev/null"]

FROM golang:1.26-alpine
WORKDIR /app
COPY --from=build-stage /app/server /app/server
EXPOSE 8080
ENTRYPOINT ["/app/server"]
